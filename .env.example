# ==========================================================
# Online Ration Shop - Environment Variables Template
# ==========================================================

# Option A: Single Database Connection URL (Recommended for Cloud: Render, Railway, Heroku, Fly.io)
# DATABASE_URL=mysql://username:password@hostname:3306/database_name

# Option B: Individual Database Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ration_shop

# App Environment
APP_ENV=production
APP_DEBUG=false
